# LiTT — entorno de restic para litt-backup.sh. Plantilla SIN valores.
# Instalar como /etc/litt-restic.env (600 root:root); el script se niega a
# correr si el archivo es un enlace, no es 600 o tiene un dueño no confiable.
# Origen de cada valor (Bitwarden Secrets Manager): README §Checklist.

# s3:https://<account-id>.r2.cloudflarestorage.com/litt-backups
RESTIC_REPOSITORY=
# Llave del repositorio restic (sin ella el respaldo es irrecuperable).
RESTIC_PASSWORD=
# Token S3 de R2 limitado al bucket litt-backups (no el de litt-docs).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 no usa regiones; restic necesita una para firmar las peticiones.
AWS_DEFAULT_REGION=auto
