# BEGIN litt
# LiTT — litt.asteroitt.com (producción).
# Bloque administrado por el paquete deploy/prod: editar SOLO entre los
# marcadores, validar y recargar el Caddy compartido (ver README.md §Caddy).
litt.asteroitt.com {
	encode zstd gzip
	# Enlaces de los correos de GoTrue: solo esta ruta llega a auth-edge.
	handle /auth/v1/verify {
		reverse_proxy litt-auth:8000
	}
	reverse_proxy litt:3000 {
		# Preservar Host público + X-Forwarded-Host: sin esto, Next standalone
		# genera URLs con el hostname interno del contenedor.
		header_up Host {host}
		header_up X-Forwarded-Host {host}
	}
}
# Complemento de Word (servicio litt-word): panel, manifest.xml y /api/* en el
# mismo origen. Caddy conserva el Host público; litt-word lo pasa al backend
# como X-Forwarded-Host.
word.litt.asteroitt.com {
	encode zstd gzip
	reverse_proxy litt-word:3200
}
# Servidor MCP de LiTT (docs/mcp-server.md): solo /mcp, /oauth/* y los
# documentos .well-known de OAuth, por el mismo gateway /api de la web (litt:3000
# reenvía /api/* al backend). Todo lo demás de este host responde 404. Con
# LITT_MCP_SERVER=disabled el backend también contesta 404 en esas rutas.
mcp.litt.asteroitt.com {
	@mcp path /mcp /mcp/* /oauth/* /.well-known/oauth-protected-resource /.well-known/oauth-protected-resource/* /.well-known/oauth-authorization-server /.well-known/oauth-authorization-server/*
	handle @mcp {
		rewrite * /api{path}
		reverse_proxy litt:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
		}
	}
	handle {
		respond 404
	}
}
# END litt
