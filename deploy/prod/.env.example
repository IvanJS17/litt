# LiTT — contrato de variables de producción.
# Copiar a /srv/litt/.env (chmod 600) y llenar. NUNCA versionar el .env real.
# Usar SIEMPRE con: docker compose --env-file /srv/litt/.env -f deploy/prod/compose.yaml

# URL pública del servicio (Caddy + DNS ya configurados).
PUBLIC_URL=https://litt.asteroitt.com

# SHA completo (40 caracteres) del commit publicado en IvanJS17/litt que se
# despliega. Es la etiqueta de las imágenes y el commit que enlaza "Código
# fuente" (AGPL-3.0 §13) — ver README §1.
LITT_SOURCE_COMMIT=

# Generar cada uno con: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
DOWNLOAD_SIGNING_SECRET=
USER_API_KEYS_ENCRYPTION_SECRET=
AUTH_HANDOFF_ENCRYPTION_SECRET=

# Secreto del borde (openssl rand -hex 32). El mismo valor debe estar en el
# entorno del Caddy compartido; litt-web, litt-word y auth-edge no arrancan sin él
# (README §Dirección del cliente).
LITT_EDGE_SECRET=

# Origen público del complemento de Word (servicio litt-word, README
# §Complemento de Word). La imagen litt-word se construye con este mismo valor
# en WORD_ADDIN_PUBLIC_URL.
WORD_ADDIN_URL=https://word.litt.asteroitt.com

# JWT de Supabase (rol anon | service_role), firmados con JWT_SECRET.
# Generar con: JWT_SECRET=<el de arriba> python3 deploy/prod/supabase-jwt.py anon
SUPABASE_ANON_KEY=
# JWT_SECRET=<el de arriba> python3 deploy/prod/supabase-jwt.py service_role
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2, bucket de documentos `litt-docs`. Token S3 limitado a ese
# bucket (el de respaldos es otro, en /etc/litt-restic.env).
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=litt-docs

# Correo del sistema (confirmación, recuperación, invitación y cambio de
# correo), enviado por GoTrue. Puerto 587 con STARTTLS (el 465 de Neubox dejó
# de responder el 2026-11-09). El host es el nombre del servidor Neubox (su
# certificado vale para ese nombre); NO mail.asteroitt.com, que pasa por el
# proxy de Cloudflare y no deja pasar SMTP.
GOTRUE_SMTP_HOST=svgs440.serverneubox.com.mx
GOTRUE_SMTP_PORT=587
GOTRUE_SMTP_USER=no-reply@asteroitt.com
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=no-reply@asteroitt.com
GOTRUE_SMTP_SENDER_NAME=LiTT

# Arranque: signup abierto, con confirmación de correo obligatoria; poner true
# cuando todo el equipo tenga cuenta (reinicia auth para aplicar).
DISABLE_SIGNUP=false

# Chat (ledger §16 "Web search and subagents in chat"). Decisión de Iván,
# 30-oct-2026: los subagentes corren en las rutas de modelo con nombre que
# configura cada usuario en Ajustes > Subagentes (sin rutas, en el modelo de
# la conversación); nunca en otro modelo si una ruta falla. La búsqueda web
# está encendida (decisión del owner, 2026-11-10): solo envía la consulta al
# servicio de búsqueda que cada usuario configuró con su propia llave.
LITT_CHAT_SUBAGENTS=enabled
LITT_CHAT_WEB_SEARCH=enabled
# Verificación de citas con TypeSafe (modo silencioso). Apagada: encenderla es
# `enabled` y exige antes publicar los textos legales y subir LEGAL_VERSION
# (docs/citation-support-check.md). La llave es de la plataforma; sin ella la
# función no existe.
LITT_CITATION_CHECK=disabled
# Verificaciones de citas por persona y día (hora de Ciudad de México), contadas en
# memoria (el API y el worker de jobs llevan cuentas separadas). Entero en dígitos,
# desde 1; un valor mayor que 1000000, de hasta 12 dígitos, se toma como 1000000;
# vacío, con formato inválido o de más de 12 dígitos: 2000.
LITT_CITATION_CHECK_DAILY_MAX_PER_PERSON=2000
TYPESAFE_API_KEY=

# Servidor MCP de LiTT (docs/mcp-server.md). Apagado por defecto. Para encenderlo:
# LITT_MCP_SERVER=enabled y LITT_MCP_PUBLIC_URL=https://<host MCP> (solo el origen).
LITT_MCP_SERVER=disabled
LITT_MCP_PUBLIC_URL=
# Orígenes de navegador autorizados a llamar a /mcp (separados por coma); vacío = ninguno.
LITT_MCP_ALLOWED_ORIGINS=
# Tope de clientes registrados a los que ninguna conexión se refiere ahora; al llegar, no se crean más.
# Entero en dígitos, desde 1; vacío u otro valor: 10000.
LITT_MCP_UNAPPROVED_CLIENTS_MAX=10000

# Conectores de Google (docs/google-workspace.md). Un solo cliente OAuth "Web"
# sirve para los tres: si GOOGLE_WORKSPACE_* está vacío, Gmail y Calendar usan
# el cliente de Drive. Redirect URIs:
#   https://litt.asteroitt.com/api/user/integrations/{google-drive,gmail,google-calendar}/oauth/callback
# Sin definir DISABLED_PROVIDERS, Drive queda apagado; una lista explícita
# (incluso vacía, que enciende los tres) reemplaza ese default.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_PICKER_API_KEY=
GOOGLE_DRIVE_PICKER_APP_ID=
# GOOGLE_WORKSPACE_OAUTH_CLIENT_ID=
# GOOGLE_WORKSPACE_OAUTH_CLIENT_SECRET=
# GOOGLE_WORKSPACE_DISABLED_PROVIDERS=
