# LiTT — contrato de variables de producción.
# Copiar a /srv/litt/.env (chmod 600) y llenar. NUNCA versionar el .env real.
# Usar SIEMPRE con: docker compose --env-file /srv/litt/.env -f deploy/prod/compose.yaml

# URL pública del servicio (Caddy + DNS ya configurados).
PUBLIC_URL=https://litt.asteroitt.com

# SHA completo (40 caracteres) del commit publicado en IvanJS17/litt que se
# despliega. Es la etiqueta de las imágenes y el commit que enlaza "Código
# fuente" (AGPL-3.0 §13) — ver README §1.
LITT_SOURCE_COMMIT=

# Generar cada uno con: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
DOWNLOAD_SIGNING_SECRET=
USER_API_KEYS_ENCRYPTION_SECRET=

# JWT de Supabase (rol anon | service_role), firmados con JWT_SECRET.
# Generar con: JWT_SECRET=<el de arriba> python3 deploy/prod/supabase-jwt.py anon
SUPABASE_ANON_KEY=
# JWT_SECRET=<el de arriba> python3 deploy/prod/supabase-jwt.py service_role
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2, bucket de documentos `litt-docs`. Token S3 limitado a ese
# bucket (el de respaldos es otro, en /etc/litt-restic.env).
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=litt-docs

# Correo del sistema (confirmación, recuperación, invitación y cambio de
# correo), enviado por GoTrue. SSL implícito en 465. El host es el nombre del
# servidor Neubox (su certificado vale para ese nombre); NO mail.asteroitt.com,
# que pasa por el proxy de Cloudflare y no deja pasar SMTP.
GOTRUE_SMTP_HOST=svgs440.serverneubox.com.mx
GOTRUE_SMTP_PORT=465
GOTRUE_SMTP_USER=no-reply@asteroitt.com
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=no-reply@asteroitt.com
GOTRUE_SMTP_SENDER_NAME=LiTT

# Arranque: signup abierto, con confirmación de correo obligatoria; poner true
# cuando todo el equipo tenga cuenta (reinicia auth para aplicar).
DISABLE_SIGNUP=false

# Chat (ledger §16 "Web search and subagents in chat"). Decisión de Iván,
# 30-oct-2026: los subagentes corren en las rutas de modelo con nombre que
# configura cada usuario en Ajustes > Subagentes (sin rutas, en el modelo de
# la conversación); nunca en otro modelo si una ruta falla. La búsqueda web
# sigue apagada: encenderla requiere otra decisión del owner.
LITT_CHAT_SUBAGENTS=enabled
LITT_CHAT_WEB_SEARCH=disabled
